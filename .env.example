
# ─────────────────────────────────────────────────────────────
#  Docker Compose (optional)
#  `docker compose up --build` works with ZERO configuration. Copy this file to
#  `.env` only if you want to override the defaults below -- compose reads them
#  from `.env` automatically. They are DEMO-ONLY defaults, never real secrets.
# ─────────────────────────────────────────────────────────────
# WW_PORT=8080                       # host port for http://localhost:<port>
# WW_DB_PASSWORD=wisewallet-demo-only
# WW_DB_ROOT_PASSWORD=root-demo-only
# WW_APP_KEY=                        # empty -> random key generated per container start
