# ─────────────────────────────────────────────────────────────
#  WiseWallet 2.0 — Environment configuration (EXAMPLE)
#  Copy this file to `.env` and adjust. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME="WiseWallet"
APP_ENV=local            # local | production
APP_DEBUG=true           # set false in production
APP_URL=http://localhost:8000

# Database (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wisewallet
DB_USER=root
DB_PASS=

# Security
# Generate a fresh 64-char hex secret:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me-to-a-64-char-random-hex-string
SESSION_LIFETIME=1800    # seconds of inactivity before auto-logout (30 min)
SESSION_SECURE=false     # true when served over HTTPS

# Brute-force protection
LOGIN_MAX_ATTEMPTS=5     # attempts allowed within the window
LOGIN_LOCKOUT=900        # lockout duration in seconds (15 min)

# External APIs (all keyless / free)
FX_API=https://api.frankfurter.app
CRYPTO_API=https://api.coingecko.com/api/v3
COUNTRIES_API=https://restcountries.com/v3.1
NEWS_RSS="https://finance.yahoo.com/news/rssindex,https://eco.sapo.pt/feed/"
API_CACHE_TTL=900        # external API cache lifetime in seconds

# Security firewall
IP_DENYLIST=
ADMIN_IP_ALLOWLIST=
API_RATE_MAX=240
