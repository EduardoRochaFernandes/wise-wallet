{
  "name": "wisewallet",
  "version": "2.0.0",
  "private": true,
  "description": "WiseWallet 2.0 — modern personal finance platform (PHP + MySQL + Tailwind).",
  "scripts": {
    "vendor": "node scripts/vendor-assets.js",
    "build:css": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --watch",
    "build": "npm run vendor && npm run build:css",
    "serve": "php -S localhost:8000 -t public"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.3.1"
  },
  "dependencies": {
    "apexcharts": "^3.49.1"
  }
}
